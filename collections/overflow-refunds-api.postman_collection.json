      "item": [
        {
          "id": "f706b8c7-bfd3-4ee3-afcc-e6007d82842f",
          "name": "Get Refunds",
          "request": {
            "name": "Get Refunds",
            "description": {
              "content": "\nReturns refunds for the authenticated nonprofit based on the provided filters.\n\n---\n\n### Refund Status\n\n* `PENDING`: The refund request has been created and is awaiting processor completion.\n* `SUCCEEDED`: The refund has completed successfully.\n* `FAILED`: The refund failed at the processor or settlement layer.\n* `CANCELED`: The refund was canceled before completion.\n* `REQUIRES_ACTION`: Additional action is required before the refund can complete.\n\n---\n\n### Refund Reasons\n\n* `REQUESTED_BY_CUSTOMER`: The donor requested the refund.\n* `FRAUDULENT`: The refund was issued due to suspected fraud.\n* `DUPLICATE`: The refund was issued for a duplicate charge.\n* `EXPIRED_OR_UNCAPTURED_CHARGE`: The original charge expired or was not captured.\n\n---\n\n### Filtering\n\n* Use `contributionId` to return refunds for a specific contribution.\n* Use `minimumUpdatedDate` and `maximumUpdatedDate` to poll for refunds that changed within a specific window.\n* Results are sorted by `createdAt` (ascending or descending via `sortDirection`) and paginated with `limit` and `page`.\n\nAll monetary amounts in the response are expressed in cents.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v3",
                "refunds"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "25",
                  "description": "The number of refunds to return."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "The page number of the refunds to return."
                },
                {
                  "disabled": false,
                  "key": "sortDirection",
                  "value": "<string>",
                  "description": "Sort direction by refund created date. Defaults to descending."
                },
                {
                  "disabled": false,
                  "key": "contributionId",
                  "value": "<string>",
                  "description": "Filter by contribution id."
                },
                {
                  "disabled": false,
                  "key": "minimumUpdatedDate",
                  "value": "<dateTime>",
                  "description": "The minimum updated date of the refunds to return."
                },
                {
                  "disabled": false,
                  "key": "maximumUpdatedDate",
                  "value": "<dateTime>",
                  "description": "The maximum updated date of the refunds to return."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
