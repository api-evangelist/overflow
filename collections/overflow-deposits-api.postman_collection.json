        {
          "id": "5f7227bc-210d-4b81-8654-41b344ce035e",
          "name": "Get Deposits",
          "request": {
            "name": "Get Deposits",
            "description": {
              "content": "\nReturns deposits for the nonprofit based on the provided filters. A deposit is a settlement from Overflow to the nonprofit's bank account.\n\n---\n\n### Deposit Status\n\n* `PENDING`: The deposit is awaiting processing.\n* `IN_TRANSIT`: The deposit has been initiated and is in transit to the bank.\n* `PAID`: The deposit has arrived in the bank account.\n* `FAILED`: The deposit failed to be processed.\n* `CANCELED`: The deposit was canceled before processing.\n\n---\n\n### Deposit Types\n\n* `AUTOMATED`: A scheduled payout initiated by Overflow.\n* `MANUAL`: A payout initiated manually.\n* `IMPORT`: An imported historical payout.\n\n---\n\n### Filtering\n\n* Use `startDate` and `endDate` to filter by the deposit's arrival date.\n* Use `minimumEstimatedValueInCents` and `maximumEstimatedValueInCents` to filter by net amount (values are in cents).\n* Use `reconciled` to filter by reconciliation status.\n\nAll monetary amounts in the response are expressed in cents.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v3",
                "deposits"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "25",
                  "description": "The number of deposits to return."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "The page number of the deposits to return."
                },
                {
                  "disabled": false,
                  "key": "createdAt",
                  "value": "<dateTime>",
                  "description": "Filter deposits created on this date."
                },
                {
                  "disabled": false,
                  "key": "startDate",
                  "value": "<dateTime>",
                  "description": "Filter deposits whose arrival date is on or after this date."
                },
                {
                  "disabled": false,
                  "key": "endDate",
                  "value": "<dateTime>",
                  "description": "Filter deposits whose arrival date is on or before this date."
                },
                {
                  "disabled": false,
                  "key": "ids",
                  "value": "<string>",
                  "description": "Filter by deposit ids."
                },
                {
                  "disabled": false,
                  "key": "ids",
                  "value": "<string>",
                  "description": "Filter by deposit ids."
                },
                {
                  "disabled": false,
                  "key": "sortBy",
                  "value": "<string>",
                  "description": "Field to sort deposits by. Defaults to arrival date."
                },
                {
                  "disabled": false,
                  "key": "sortDirection",
                  "value": "<string>",
                  "description": "Sort direction. Defaults to descending."
