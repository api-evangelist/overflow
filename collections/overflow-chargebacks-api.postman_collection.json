      "item": [
        {
          "id": "5fcca20b-afca-4296-9ed8-fdea75452136",
          "name": "Get Chargebacks",
          "request": {
            "name": "Get Chargebacks",
            "description": {
              "content": "\nReturns chargebacks for the authenticated nonprofit based on the provided filters.\n\n---\n\n### Chargeback Status\n\n* `pending`: The chargeback is still in progress.\n* `lost`: The chargeback was finalized against the nonprofit.\n* `won`: The chargeback was finalized in the nonprofit's favor.\n\n---\n\n### Chargeback Types\n\n* `ach_return`: The chargeback originated from an ACH return.\n* `dispute`: The chargeback originated from a card dispute.\n\n---\n\n### Filtering\n\n* Use `contributionId` to return chargebacks for a specific contribution.\n* Use `minimumUpdatedDate` and `maximumUpdatedDate` to poll for chargebacks that changed within a specific window.\n* Results are sorted by `createdAt` (ascending or descending via `sortDirection`) and paginated with `limit` and `page`.\n\nAll monetary amounts in the response are expressed in cents.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v3",
                "chargebacks"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "25",
                  "description": "The number of chargebacks to return."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "The page number of the chargebacks to return."
                },
                {
                  "disabled": false,
                  "key": "sortDirection",
                  "value": "<string>",
                  "description": "Sort direction by chargeback created date. Defaults to descending."
                },
                {
                  "disabled": false,
                  "key": "contributionId",
                  "value": "<string>",
                  "description": "Filter by contribution id."
                },
                {
                  "disabled": false,
                  "key": "minimumUpdatedDate",
                  "value": "<dateTime>",
                  "description": "The minimum updated date of the chargebacks to return."
                },
                {
                  "disabled": false,
                  "key": "maximumUpdatedDate",
                  "value": "<dateTime>",
                  "description": "The maximum updated date of the chargebacks to return."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "x-client-id"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
